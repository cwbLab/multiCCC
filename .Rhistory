###output
message( '[Step 1/2 | ', format(Sys.time(), "%Y-%m-%d %H:%M:%S") , ' ] ','Done.'  )
###LRscore
message( '[Step 1/2 | ', format(Sys.time(), "%Y-%m-%d %H:%M:%S") , ' ] ','Calculating communication strength score (LRscore).'  )
###output
message( '[ ', format(Sys.time(), "%Y-%m-%d %H:%M:%S") , ' ] ','Done.'  )
###
run.start = Sys.time()
###output
run.end = Sys.time()
